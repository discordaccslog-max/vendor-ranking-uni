# Copy this file to .env.local (never commit .env.local).

# Where vendor reports are sent. Optional when running locally (reports are
# also saved to .data/reports.jsonl), but REQUIRED on hosts like Vercel that
# can't save files. Accepts a Discord webhook, a Slack incoming webhook, or any
# URL that accepts a JSON POST.
#   Discord: Channel settings → Integrations → Webhooks → New Webhook → Copy URL
REPORT_WEBHOOK_URL=
